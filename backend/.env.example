# Configuração do backend do MeteMarcha. Copie para ".env" (ou, na VPS, para
# /etc/metemarcha/metemarcha.env). Não há segredos aqui: o servidor não usa
# chaves de API. Tudo é opcional; o que estiver comentado usa o valor padrão.
#
# Para carregar no terminal:   set -a; source .env; set +a
# Durações usam o formato do Go: 90s, 15m, 24h (para dias, multiplique: 7 dias = 168h).

# --- Rede e armazenamento ------------------------------------------------------
# Ouvir só em localhost: quem fala com a internet é o proxy HTTPS (veja README).
MM_ADDR=127.0.0.1:8080
MM_DB_PATH=./data/metemarcha.db
MM_MEDIA_DIR=./data/media          # fotos (privadas, nunca servidas como arquivos estáticos)
MM_MUSIC_DIR=./data/music          # catalog.json + arquivos de áudio

# --- Rodas ---------------------------------------------------------------------
# MM_GROUP_MAX_MEMBERS=10
# MM_INVITE_TTL=168h               # validade de um convite de roda (7 dias)

# --- Stories (prazos contados a partir da publicação) --------------------------
# MM_STORY_VISIBLE_FOR=24h         # visível no feed aos participantes
# MM_STORY_RECOVERABLE_FOR=72h     # até aqui só o autor baixa a foto; depois, nada (e é apagado)
# MM_MAX_CLIP=30s                  # duração máxima do trecho de música

# --- Uploads -------------------------------------------------------------------
# MM_MAX_PHOTO_BYTES=8388608       # 8 MiB
# MM_MAX_PHOTO_SIDE=4096           # maior lado da imagem, em pixels

# --- Contas --------------------------------------------------------------------
# MM_SESSION_TTL=720h              # validade de uma sessão (30 dias)
# MM_PASSWORD_MEMORY_KIB=65536     # custo do argon2id (64 MiB); só reduza em VPS muito pequena

# --- Limpeza -------------------------------------------------------------------
# MM_CLEANUP_INTERVAL=15m          # de quanto em quanto tempo a limpeza roda
# MM_ORPHAN_GRACE=1h               # idade mínima para um arquivo sem registro ser considerado órfão
